{
  "height": 30,
  "spacing": 4,
  "layer": "top",
  "position": "top",

  // Choose which modules to display in the Left, Center, and Right zones
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "clock", "tray"],
  // "modules-right": ["cpu", "memory", "disk", "clock", "tray"],

  // Module specific configurations
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false, // Only show workspaces active on the current monitor
    "format": "{value}",
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 1, // refresh every second
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
  },
  "cpu": {
    "format": "CPU: {usage}%",
    "tooltip": true,
  },
  "memory": {
    "format": "RAM: {}%",
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
  },
}
