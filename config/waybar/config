{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  // Choose which modules to display in the Left, Center, and Right zones
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "clock", "tray"],
  // "modules-right": ["cpu", "memory", "disk", "clock", "tray"],

  // Module specific configurations
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false, // Only show workspaces active on the current monitor
    "format": "{value}",
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 1, // refresh every second
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "cpu": {
    "format": "CPU: {usage}%",
    "tooltip": false,
  },
  "memory": {
    "format": "RAM: {}%",
  },
  // TODO: how to show /home partition only?
  // "disk": {
  //   "interval": 60,
  //   "format": "{percentage_free}% {path}"
  // },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
  },
}
