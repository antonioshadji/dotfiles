{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "solarized"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "permissions": "autoaccept"
  },
  "animations": true,
  "plugins": [
    "./herdr-opencode"
  ],
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true
  }
}
