{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilo/frontier",
  "providers": {
    "kilo": {
      "name": "Kilo Gateway",
      "env": ["KILO_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.kilo.ai/api/gateway"
      },
      "headers": {
        "X-KiloCode-OrganizationId": "30f1620a-4aad-4456-bf4d-550f335e6f55"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Kilo)",
          "modelID": "anthropic/claude-sonnet-4.6",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (Kilo)",
          "modelID": "anthropic/claude-opus-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5-4": {
          "name": "GPT 5.4 (Kilo)",
          "modelID": "openai/gpt-5.4",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "frontier": {
          "name": "Kilo Auto Frontier",
          "modelID": "kilo-auto/frontier",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "efficient": {
          "name": "Kilo Auto Efficient",
          "modelID": "kilo-auto/efficient",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "anaconda-mcp": {
        "type": "remote",
        "url": "https://anaconda.com/api/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.secrets/anaconda-mcp-token}"
        }
      },
      "cursor_oracle": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--python",
          "3.12",
          "--with",
          "anthropic",
          "--with",
          "arize-phoenix-otel",
          "--with",
          "claude-agent-sdk",
          "--with",
          "click",
          "--with",
          "fastmcp",
          "--with",
          "openinference-instrumentation-anthropic",
          "--with",
          "opentelemetry-api",
          "--with",
          "opentelemetry-exporter-otlp",
          "--with",
          "opentelemetry-sdk",
          "--with",
          "outerbounds",
          "fastmcp",
          "run",
          "/Users/ahadjigeorgalis/Code/Outerbounds/ob-claude-trippin/cc_flows/cursor_oracle.py"
        ],
        "environment": {
          "METAFLOW_DOCS_DIR": "/Users/ahadjigeorgalis/Code/Outerbounds/ob-claude-trippin/metaflow_system_prompt/ask_metaflow_resources",
          "ANTHROPIC_API_KEY": "",
          "METAFLOW_PROFILE": "gtm01",
          "METAFLOW_ORACLE_MAX_TURNS": "100"
        }
      }
    }
  },
  "shell": "/opt/bash/bin/bash"
}
