{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilo-auto/org",
  "providers": {
    "kilo": {
      "name": "Kilo Gateway",
      "env": ["KILO_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.kilo.ai/api/gateway"
      },
      "headers": {
        "X-KiloCode-OrganizationId": "30f1620a-4aad-4456-bf4d-550f335e6f55"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Kilo)",
          "modelID": "anthropic/claude-sonnet-4.6",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (Kilo)",
          "modelID": "anthropic/claude-opus-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gpt-5-4": {
          "name": "GPT 5.4 (Kilo)",
          "modelID": "openai/gpt-5.4",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "frontier": {
          "name": "Kilo Auto Frontier",
          "modelID": "kilo-auto/frontier",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "efficient": {
          "name": "Kilo Auto Efficient",
          "modelID": "kilo-auto/efficient",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "anaconda-mcp": {
      "type": "remote",
      "url": "https://anaconda.com/api/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/anaconda-mcp-token}"
      }
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    }
  },
  "shell": "/opt/bash/bin/bash"
}
